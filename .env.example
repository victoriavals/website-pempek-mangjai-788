# ============================================================
# Pempek 788 Mang Jai — Environment Variables (template)
# ============================================================
# Copy file ini jadi `.env.local` lalu isi nilainya.
# `.env.local` gitignored; `.env.example` ini boleh ter-commit
# sebagai dokumentasi variabel apa saja yang dibutuhkan.
# ============================================================

# URL CSV publish-to-web dari Google Sheets (inventory + harga + stock).
# Lihat README / CLAUDE.md untuk cara setup. Kalau kosong, website
# fallback ke data/default-inventory.ts (harga default, tanpa stock badge).
GOOGLE_SHEETS_PRODUCTS_CSV_URL=

# (Opsional) Canonical site URL untuk SEO/sitemap/OG. Default ke vercel.app.
NEXT_PUBLIC_SITE_URL=
